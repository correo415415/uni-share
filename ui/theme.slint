// uni-share design system — "Graphite" theme.
// Every widget in the app is drawn from these tokens; we do not use the
// toolkit's built-in styles so the look is ours (dense, desktop, calm).

export global Theme {
    in-out property <bool> dark: true;

    // Surfaces
    out property <color> bg:      dark ? #0f1216 : #f3f5f8;
    out property <color> bg2:     dark ? #141920 : #ffffff;
    out property <color> bg3:     dark ? #1a2029 : #eef1f5;
    out property <color> bg4:     dark ? #212935 : #e3e8ef;
    out property <color> line:    dark ? #2a3441 : #d6dce5;
    out property <color> line2:   dark ? #344153 : #c3ccd8;
    // Text
    out property <color> fg:      dark ? #e6ebf2 : #141a22;
    out property <color> fg2:     dark ? #a6b1c2 : #4a5568;
    out property <color> fg3:     dark ? #6f7d92 : #8592a6;
    // Accent
    out property <color> accent:  #21d4b4;
    out property <color> accent2: #7c6cff;
    out property <color> on-accent: #08111a;
    out property <brush> accent-grad: @linear-gradient(135deg, #21d4b4 0%, #7c6cff 100%);
    // Semantic
    out property <color> ok:   #38d39f;
    out property <color> warn: #f5b942;
    out property <color> err:  #ff5d6c;
    out property <color> info: #56a8ff;
    out property <color> sel:      dark ? #21d4b41f : #21a08c1f;
    out property <color> sel-line: dark ? #21d4b473 : #21a08c80;

    // Metrics
    out property <length> radius: 8px;
    out property <length> radius-sm: 6px;
    out property <length> radius-lg: 14px;
    out property <length> toolbar-h: 48px;
    out property <length> status-h: 26px;
    out property <length> sidebar-w: 236px;
    out property <length> row-h: 34px;
    out property <length> control-h: 32px;

    // Type
    out property <length> fs: 13px;
    out property <length> fs-sm: 11.5px;
    out property <length> fs-xs: 10.5px;
    out property <length> fs-lg: 15px;
    out property <string> mono: "JetBrains Mono, Cascadia Code, DejaVu Sans Mono, Menlo, Consolas, monospace";
}
